# ARCANA — AI reading engine configuration (server-side only; never prefix with NEXT_PUBLIC_).
#
# The app works with no configuration: "AI interpretation" is off by default in Settings,
# and readings are composed offline from each card's meaning.
#
# To enable AI readings, add your key, restart the server, and turn on
# Settings → Reading → AI interpretation.
ANTHROPIC_API_KEY=

# Optional. Leave unset to use Claude automatically when ANTHROPIC_API_KEY is present.
# "mock" forces the deterministic development provider (no key needed).
# ARCANA_AI_PROVIDER=

# Optional overrides
# ARCANA_AI_MODEL=claude-opus-5-5
# ARCANA_AI_TIMEOUT_MS=45000

# Mock provider testing aids: simulate a failure mode ("timeout" | "rate_limit" | "malformed" | "unavailable")
# ARCANA_MOCK_FAIL=
# ARCANA_MOCK_DELAY_MS=900
