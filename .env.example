# ARCANA — AI reading engine configuration (server-side only; never prefix with NEXT_PUBLIC_).
#
# Provider: "mock" (default, no credentials, deterministic offline interpreter)
#        or "anthropic" (Claude via the Anthropic Messages API).
ARCANA_AI_PROVIDER=mock

# Required when ARCANA_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional overrides
# ARCANA_AI_MODEL=claude-sonnet-5-5
# ARCANA_AI_TIMEOUT_MS=45000

# Mock provider testing aids: simulate a failure mode ("timeout" | "rate_limit" | "malformed" | "unavailable")
# ARCANA_MOCK_FAIL=
# ARCANA_MOCK_DELAY_MS=900
